{
  "name": "voice-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on WebSocket gateway between Twilio ConversationRelay and the app's signed voice turn endpoint. No business logic.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
